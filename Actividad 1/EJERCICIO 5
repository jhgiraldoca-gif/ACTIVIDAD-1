import java.util.Scanner;
class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        System.out.print("DIGITE EL RADIO DEL CIRCULO: ");
        double r = scanner.nextDouble();
        double y = operaciones.area(r);
        double z = operaciones.circunf(r);
        System.out.println("EL AREA ES: " + y);
        System.out.println("LA CIRCUNFERENCIA ES: " + z);

    }
}
class operaciones{
    public static double area(double r){
        return Math.PI * Math.pow(r,2);
    }
    public static double circunf(double r){
        return 2 * Math.PI * r;
    }
}
